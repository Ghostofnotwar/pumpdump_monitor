# Required. Never commit the real token.
BOT_TOKEN=

# Local Python default. Docker/Fly override this to /data/bot.db.
DATABASE_URL=sqlite:///data/bot.db
# SNAPSHOT_DIR=data/snapshots

# Optional HTTPS Mini App URL, no query/fragment. Set after choosing the Fly app name.
# WEB_APP_URL=https://YOUR-APP.fly.dev/webapp
# Recommended for a private bot: comma-separated Telegram chat IDs.
# Empty preserves public /start registration. Mini App always requires a Telegram signature.
ALLOWED_CHAT_IDS=

PORT=8000
LOG_LEVEL=INFO
BYBIT_REST=https://api.bybit.com
# Legacy CLOUDFLARE_PROXY is still read only when BYBIT_REST is unset.
# CLOUDFLARE_PROXY=https://your-worker.example.workers.dev
BYBIT_TIMEOUT_SEC=15
MAX_CONCURRENT_REQUESTS=8

PAIRS_UPDATE_MIN=5
POLL_INTERVAL_SEC=2
ALERT_WINDOW_SEC=300
ALERT_COOLDOWN_SEC=600
MAX_SYMBOLS=500
MIN_UNIVERSE_VOLUME_USD=50000
ALERT_WORKERS=2
ALERT_QUEUE_SIZE=100

ALERT_RETENTION_DAYS=30
SNAPSHOT_RETENTION_DAYS=7
SNAPSHOT_MAX_MB=512
# Keep commands received during a short restart. Enable only if you intentionally want to discard them.
DROP_PENDING_UPDATES=false
